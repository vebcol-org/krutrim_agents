# One shared env file for the whole project — backend, frontend, and
# docker-compose all read this same file. Copy it once:
#
#   cp .env.example .env
#
# backend/.env, apps/web/.env.local, and docker/.env are committed SYMLINKS
# pointing at this root .env (see docker/README.md) — edit values here only,
# never in those three locations directly.

# ---------------------------------------------------------------------------
# Backend (krutrim_agent_backend / krutrim_agent_celery) — see backend/README.md
# ---------------------------------------------------------------------------

# Only the env var *names* referenced by provider settings (see
# harness/memory/settings.json, created on first run) matter here — never
# put API keys in settings.json itself.
# Also used for RAG embeddings (krutrim_agent_rag) — see
# KRUTRIM_AGENT_RAG_EMBEDDING_MODEL below.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# Only needed when OPENROUTER_BASE_URL points at a local dev proxy
# (e.g. krutrim-dev-proxy-server) that authenticates via its own master key
# instead of a real OpenRouter key — must match that proxy's LITELLM_MASTER_KEY.
# LITELLM_MASTER_KEY=

# Optional — enables the Tavily-backed web-search tool
# (krutrim_agents_core/tools/websearch/tavily.py). Falls back to the
# zero-config DuckDuckGo tool if unset. Set
# KRUTRIM_AGENT_WEB_SEARCH_PROVIDER=tavily below to actually switch to it.
# TAVILY_API_KEY=
# TAVILY_SEARCH_API_BASE=

# Optional overrides (defaults shown). Uses the KRUTRIM_AGENT_ env prefix -
# see backend/libs/krutrim_agent_management/src/krutrim_agent_management/config.py.
# KRUTRIM_AGENT_HOST=0.0.0.0
# KRUTRIM_AGENT_PORT=8000
# KRUTRIM_AGENT_SANDBOX_IMAGE=krutrim_agent-sandbox:latest
# KRUTRIM_AGENT_SANDBOX_RUNTIME=docker
# KRUTRIM_AGENT_CORS_ORIGINS=["http://localhost:4200","http://localhost:5173"]
# KRUTRIM_AGENT_WEB_SEARCH_PROVIDER=duckduckgo
# KRUTRIM_AGENT_RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Celery broker/result-backend (idle-container reaper - see
# backend/services/krutrim_agent_celery/). Running the stack via
# docker/docker-compose.yml overrides this automatically to point at the
# `redis` service (with REDIS_USER/REDIS_PASSWORD below, if set); this value
# is what a backend run directly on the host (`uv run uvicorn ...`) uses
# instead, e.g. against `docker compose -f docker/docker-compose.yml up redis`.
# KRUTRIM_AGENT_REDIS_URL=redis://localhost:6379/0

# Idle-container reaper tuning (krutrim_agent_celery/config.py) - note the
# KRUTRIM_AGENT_CELERY_ prefix, not KRUTRIM_AGENT_.
# KRUTRIM_AGENT_CELERY_IDLE_TIMEOUT_SECONDS=600
# KRUTRIM_AGENT_CELERY_BEAT_INTERVAL_SECONDS=60

# Dev mode gate for local-only tooling (currently: Langfuse tracing below).
# Accepts either name - KRUTRIM_AGENT_DEV_MODE takes priority if both are set.
# KRUTRIM_AGENT_DEV_MODE=true
# DEV_MODE=true

# Langfuse tracing (see krutrim_agents_core.observability) - only takes effect when
# dev_mode is on above. Every chat model call gets traced once both keys
# are set. Get these from your Langfuse project settings.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000   # self-hosted; omit for Langfuse Cloud
# LANGFUSE_HOST=https://cloud.langfuse.com  # fallback if LANGFUSE_BASE_URL is unset

# Only read inside docker/docker-compose.yml's backend/celery-worker
# services — everywhere else (native `uv run uvicorn`, etc.) just uses
# LANGFUSE_BASE_URL/LANGFUSE_HOST above directly. Leave unset for local
# dev: compose auto-points containers at host.docker.internal:3000 so a
# Langfuse instance running on your own machine just works. Set this to
# point containers at a real (e.g. production) Langfuse URL instead —
# takes effect purely from this file, no docker-compose.yml edit needed.
# LANGFUSE_DOCKER_BASE_URL=https://your-langfuse.example.com

# ---------------------------------------------------------------------------
# Frontend (apps/web) — see docker/README.md's "Frontend build-time URL"
# ---------------------------------------------------------------------------

# Where the browser reaches the backend. Baked in at BUILD time for the
# Docker/production build (Vite convention — no server to read env vars from
# at runtime); read live by `vite dev` for local dev.
VITE_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# docker-compose (docker/docker-compose.yml) — Redis auth
# ---------------------------------------------------------------------------

# Leave both blank to keep today's behavior: no auth, redis reachable by
# anyone who can reach the port. Set both to require auth — docker-compose
# passes REDIS_PASSWORD to the redis container's --requirepass and threads
# both into KRUTRIM_AGENT_REDIS_URL for `backend`/`celery-worker`. "default"
# is Redis's built-in user name (no ACLs are configured here), not a
# placeholder to change.
# REDIS_USER=default
# REDIS_PASSWORD=
